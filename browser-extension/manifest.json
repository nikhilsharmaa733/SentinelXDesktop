{
  "manifest_version": 3,
  "name": "SentinelX Bridge",
  "version": "1.1.0",
  "description": "Fill and capture logins from your local SentinelX vault. Talks only to the SentinelX app on this machine — never to any server.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "sentinelx-bridge@nikhil.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SentinelX Bridge",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
